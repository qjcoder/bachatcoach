PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/bachatcoach
JWT_SECRET=change-this-to-a-long-random-string-in-production
# Comma-separated Google OAuth client IDs (Web, iOS, Android)
GOOGLE_CLIENT_IDS=
# Web OAuth client secret — server only. Never put this in the mobile app.
GOOGLE_CLIENT_SECRET=
# Email OTP (free via Resend — https://resend.com). Without RESEND_API_KEY, codes log to the console.
RESEND_API_KEY=
EMAIL_FROM=BachatCoach <onboarding@resend.dev>
