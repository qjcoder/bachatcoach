{
  "expo": {
    "name": "BachatCoach",
    "slug": "bachatcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "com.googleusercontent.apps.966711411072-vlfkub8d4ipulb0ofsgojmc48nm7edmf",
      "com.googleusercontent.apps.966711411072-gdj8p0120sqshgobnkvnbkk02vbh0bb5",
      "bachatcoach"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bachatcoach.app"
    },
    "android": {
      "package": "com.bachatcoach.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 380,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BachatCoach to use Face ID to unlock your finances."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BachatCoach to access your photos to attach receipt records.",
          "cameraPermission": "Allow BachatCoach to use the camera to photograph receipts."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
